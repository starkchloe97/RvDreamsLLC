Options -MultiViews
RewriteEngine On

# Keep real files (assets, robots.txt, sitemap.xml) untouched.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Vue Router history-mode fallback for product, collection and content URLs.
RewriteRule ^ index.html [L]
